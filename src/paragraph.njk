---
pagination:
  data: paragraphs
  size: 1
  alias: paragraph
permalink: "/{{ paragraph.chapterId }}/{{ paragraph.slug }}/index.html"
layout: layouts/base.njk
eleventyComputed:
  title: "§{{ paragraph.num }} — {{ paragraph.chapterTitle }}"
  description: "Anotasi paragraf {{ paragraph.num }} dari {{ site.workTitle }} karya {{ site.workAuthor }}."
---
<article
  class="page page--focus"
  data-focus-page
  {% if paragraph.prev %}
    data-prev-url="{{ ('/' + paragraph.prev.chapterId + '/' + paragraph.prev.slug + '/') | url }}" data-prev-label="§{{ paragraph.prev.num }}"
  {% endif %}
  {% if paragraph.next %}
    data-next-url="{{ ('/' + paragraph.next.chapterId + '/' + paragraph.next.slug + '/') | url }}" data-next-label="§{{ paragraph.next.num }}"
  {% endif %}
>
  <div class="focus-kicker">
    <a href="{{ ('/' + paragraph.chapterId + '/') | url }}">
      {{ paragraph.chapterShortLabel }}
    </a>
    <span>›</span>
    <span>§{{ paragraph.num }}</span>
    {% for h in paragraph.headingPath %}
      <span>›</span>
      <span class="focus-kicker__muted">{{ h.label }}. {{ h.title }}</span>
    {% endfor %}
  </div>

  <div class="focus-header">
    <div>
      <span class="eyebrow">PARAGRAPH</span>
      <h1>§{{ paragraph.num }}</h1>
    </div>
    <a
      class="focus-context"
      href="{{ ('/' + paragraph.chapterId + '/#' + paragraph.slug) | url }}"
    >
      Lihat konteks bab
      <span>↗</span>
    </a>
  </div>

  <section class="focus-source">
    <div class="focus-source__label">TEXT / C. G. JUNG</div>
    <div class="para__text">{{ paragraph.html | safe }}</div>
  </section>

  {% if paragraph.annotationHtml %}
    <section class="annotation annotation--focus">
      <div class="annotation__head">
        <span>ANNOTATION</span>
        <span>§{{ paragraph.num }}</span>
      </div>
      {{ paragraph.annotationHtml | safe }}
    </section>
  {% else %}
    <section class="empty-state empty-state--focus">
      <span class="empty-state__mark">∅</span>
      <div>
        <strong>Belum ada catatan.</strong>
      </div>
    </section>
  {% endif %}

  <nav class="paragraph-nav" aria-label="Navigasi paragraf">
    {% if paragraph.prev %}
      <a
        href="{{ ('/' + paragraph.prev.chapterId + '/' + paragraph.prev.slug + '/') | url }}"
      >
        <small>← Prev</small>
        <strong>§{{ paragraph.prev.num }}</strong>
      </a>
    {% else %}
      <span></span>
    {% endif %}
    <a
      class="paragraph-nav__middle"
      href="{{ ('/' + paragraph.chapterId + '/#' + paragraph.slug) | url }}"
    >
      Daftar bab
    </a>
    {% if paragraph.next %}
      <a
        class="paragraph-nav__next"
        href="{{ ('/' + paragraph.next.chapterId + '/' + paragraph.next.slug + '/') | url }}"
      >
        <small>Next →</small>
        <strong>§{{ paragraph.next.num }}</strong>
      </a>
    {% endif %}
  </nav>
</article>
