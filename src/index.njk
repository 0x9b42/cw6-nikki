---
layout: layouts/base.njk
permalink: /index.html
---
<section class="home-hero page--wide">
  <div class="home-hero__grid">
    <div>
      <div class="eyebrow home-hero__eyebrow">{{ site.workNote }}</div>
      <h1>{{ site.title }}</h1>
      <p class="home-hero__tagline">{{ site.tagline }}</p>
      <div class="hero-actions">
        <a class="button button--primary" href="{{ '/intro/' | url }}">
          Mulai membaca
          <span>→</span>
        </a>
        <a class="button button--ghost" href="{{ '/catatan/' | url }}">
          Buka catatan
          <span>{{ stats.totalAnnotated }}</span>
        </a>
      </div>
    </div>
    <aside class="hero-note">
      <div class="eyebrow">STATUS EDISI</div>
      <div class="hero-note__stat">
        <strong>{{ stats.totalAnnotated }}</strong>
        <span>/ {{ stats.totalParagraphs }} § dianotasi</span>
      </div>
      <div class="progress-bar progress-bar--hero">
        <span
          class="progress-bar__fill"
          style="width: {{ (stats.totalAnnotated / stats.totalParagraphs * 100) | round(1) }}%"
        ></span>
      </div>
      <p>
        Nomor paragraf mengikuti edisi
        <em>The Collected Works of C. G. Jung, Volume 6</em>
        . Teks sumber dan catatan sengaja dipisahkan sebagai dua lapisan pembacaan.
      </p>
    </aside>
  </div>
</section>

<div class="home-divider page--wide">
  <span>CHAPTERS</span>
  <i></i>
  <span>READING MAP</span>
</div>

<section
  class="page--wide chapter-browser"
  aria-labelledby="chapter-browser-title"
>
  <div class="section-intro">
    <div>
      <span class="eyebrow">NAVIGASI</span>
    </div>
  </div>

  <div class="chapter-grid">
    {% for chapter in chapters %}
      <a class="chapter-card" href="{{ ('/' + chapter.id + '/') | url }}">
        <div class="chapter-card__top">
          <span>{{ chapter.shortLabel }}</span>
          <span>{{ chapter.paragraphCount }} §</span>
        </div>
        <span class="chapter-card__title">{{ chapter.title }}</span>
        <div class="chapter-card__bottom">
          <span>§{{ chapter.firstParagraph }}–{{ chapter.lastParagraph }}</span>
          <span class="chapter-card__annotation">
            {{ chapter.annotatedCount }}
            catatan
            {% if chapter.annotatedCount %}
              ↗
            {% endif %}
          </span>
        </div>
        <span class="chapter-card__arrow" aria-hidden="true">↗</span>
      </a>
    {% endfor %}
  </div>
</section>
