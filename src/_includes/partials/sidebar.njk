<aside id="sidebar" class="sidebar" aria-label="Daftar isi">
  <div class="sidebar__brand-meta">
    <p class="sidebar__work">{{ site.workTitle }}</p>
    <p class="sidebar__work-author">{{ site.workAuthor }} · {{ site.workNote }}</p>
  </div>

  <div class="sidebar__section">
    <div class="sidebar__progress">
      <span class="sidebar__progress-num">{{ stats.totalAnnotated }}</span>
      <span style="color: var(--ink-3);">/ {{ stats.totalParagraphs }}</span>
      <div class="sidebar__progress-bar">
        <div
          class="sidebar__progress-fill"
          style="width: {{ (stats.totalAnnotated / stats.totalParagraphs * 100) | round(1) }}%"
        ></div>
      </div>
    </div>
    <p
      style="font-size: 0.72rem; color: var(--ink-3); margin: 0.35rem 0 0; line-height: 1.4;"
    >
      paragraf dianotasi sejauh ini
    </p>
  </div>

  <div class="sidebar__section">
    <p class="sidebar__label">Daftar Isi</p>
    <ul class="toc">
      {% for chapter in chapters %}
        {% set chapterUrl = ('/' + chapter.id + '/') | url %}
        {% set isCurrent = page.url | startsWith(chapterUrl) %}
        <li
          class="
            toc__item
            {% if isCurrent %}
              toc__item--open
            {% endif %}
          "
        >
          <a
            class="toc__chapter"
            href="{{ ('/' + chapter.id + '/') | url }}"
            {% if isCurrent %}
              aria-current="page"
            {% endif %}
          >
            <span class="toc__symbol">{{ chapter.symbol or "·" }}</span>
            <span class="toc__title">{{ chapter.title }}</span>
            {% if chapter.annotatedCount > 0 %}
              <span class="toc__count">
                {{ chapter.annotatedCount }}
              </span>
            {% endif %}
          </a>
        </li>
      {% endfor %}
    </ul>
  </div>

  <div class="sidebar__footer">
    <a class="sidebar__footer-link" href="{{ '/anotasi/' | url }}">
      <svg
        viewBox="0 0 24 24"
        width="14"
        height="14"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
        <path
          d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"
        />
      </svg>
      Indeks anotasi
    </a>
  </div>
</aside>
