<aside id="sidebar" class="sidebar" aria-label="Navigasi utama">
  <div class="sidebar__top">
    <a class="sidebar__brand" href="{{ '/' | url }}">
      <span class="brand-mark" aria-hidden="true">CW</span>
      <span>{{ site.shortTitle }}</span>
    </a>
    <button
      class="icon-btn sidebar__close"
      type="button"
      data-nav-close
      aria-label="Tutup daftar isi"
    >
      ×
    </button>
  </div>

  <p class="sidebar__work">
    <em>{{ site.workTitle }}</em>
    <br />
    {{ site.workAuthor }}
  </p>

  <button class="sidebar-search" type="button" data-search-open>
    <span class="sidebar-search__icon" aria-hidden="true">⌕</span>
    <span>Cari paragraf, istilah…</span>
    <kbd>⌘K</kbd>
  </button>

  <div class="sidebar__progress-card">
    <div class="eyebrow">PROGRESS CATATAN</div>
    <div class="sidebar__progress-row">
      <strong>{{ stats.totalAnnotated }}</strong>
      <span>/ {{ stats.totalParagraphs }}</span>
      <span class="sidebar__progress-percent">{{ (stats.totalAnnotated / stats.totalParagraphs * 100) | round(1) }}%</span>
    </div>
    <div class="progress-bar">
      <span
        class="progress-bar__fill"
        style="width: {{ (stats.totalAnnotated / stats.totalParagraphs * 100) | round(1) }}%"
      ></span>
    </div>
  </div>

  <div class="sidebar__section-head">
    <span>ISI</span>
    <a href="{{ '/catatan/' | url }}">{{ annotatedIndex.length }} catatan</a>
  </div>

  <nav class="toc" aria-label="Daftar bab">
    <a class="toc__home" href="{{ '/' | url }}">Beranda</a>
    {% for chapter in chapters %}
      <a
        class="toc__link"
        href="{{ ('/' + chapter.id + '/') | url }}"
        {% if page.url == ('/' + chapter.id + '/') | url %}
          aria-current="page"
        {% endif %}
      >
        <span class="toc__symbol">{{ chapter.symbol or "·" }}</span>
        <span class="toc__body">
          <span class="toc__title">{{ chapter.title }}</span>
          <span class="toc__meta">§{{ chapter.firstParagraph }}–{{ chapter.lastParagraph }}</span>
        </span>
        <span class="toc__count">{{ chapter.annotatedCount }}</span>
      </a>
    {% endfor %}
  </nav>

  <div class="sidebar__bottom">
    <a href="{{ '/catatan/' | url }}">Catatan &amp; anotasi <span>→</span></a>
    <a href="{{ '/book-copyright/' | url }}">
      Hak cipta &amp; sumber
      <span>→</span>
    </a>
    <button type="button" data-settings-open>
      Preferensi membaca
      <span>⌘,</span>
    </button>
  </div>
</aside>
