<!doctype html>
<html lang="id" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f4f0e7" />
    <title>
      {% if title %}
        {{ title }} —
      {% endif %}
      {{ site.title }}
    </title>
    <meta name="description" content="{{ description or site.tagline }}" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Source+Serif+4:opsz,wght@8..60,450;8..60,550;8..60,650&display=swap"
    />
    <link rel="stylesheet" href="{{ '/assets/css/style.css' | url }}" />
  </head>
  <body data-page-url="{{ page.url }}">
    <div class="noise" aria-hidden="true"></div>
    <button
      class="nav-toggle"
      type="button"
      data-nav-toggle
      aria-expanded="false"
      aria-controls="sidebar"
      aria-label="Buka daftar isi"
    >
      <span class="nav-toggle__icon" aria-hidden="true">☰</span>
      <span class="nav-toggle__label">Daftar isi</span>
    </button>

    <div class="shell">
      <div class="nav-backdrop" data-nav-close aria-hidden="true"></div>
      {% include "partials/sidebar.njk" %}

      <main id="main" class="main">
        <header class="topbar">
          <div class="topbar__context">
            {% if chapter %}
              <span class="topbar__eyebrow">
                {{ chapter.shortLabel }}
              </span>
              <span class="topbar__chapter">
                {{ chapter.title }}
              </span>
            {% elif paragraph %}
              <span class="topbar__eyebrow">§{{ paragraph.num }}</span>
              <span class="topbar__chapter">{{ paragraph.chapterTitle }}</span>
            {% else %}
              <span class="topbar__eyebrow">
                {{ site.workNote }}
              </span>
              <span class="topbar__chapter">
                {{ site.workTitle }}
              </span>
            {% endif %}
          </div>
          <div class="topbar__actions">
            <button class="topbar-btn" type="button" data-search-open>
              <span>Search</span>
              <kbd>⌘K</kbd>
            </button>
            <button
              class="topbar-btn topbar-btn--icon"
              type="button"
              data-settings-open
              aria-label="Preferensi membaca"
            >
              Aa
            </button>
          </div>
        </header>

        <div class="reader-shell" data-reader-shell>{{ content | safe }}</div>
      </main>
    </div>

    <div class="search-layer" data-search-layer hidden>
      <div class="search-backdrop" data-search-close></div>
      <section
        class="search-dialog"
        role="dialog"
        aria-modal="true"
        aria-labelledby="search-title"
      >
        <div class="search-dialog__head">
          <div>
            <span class="eyebrow">NAVIGATOR</span>
            <h2 id="search-title">Cari di seluruh buku</h2>
          </div>
          <button
            class="icon-btn"
            type="button"
            data-search-close
            aria-label="Tutup"
          >
            ×
          </button>
        </div>
        <label class="search-input-wrap">
          <span aria-hidden="true">⌕</span>
          <input
            data-search-input
            type="search"
            autocomplete="off"
            aria-label="Cari di seluruh buku"
            placeholder="Cari istilah, frasa, atau nomor paragraf…"
          />
          <kbd>Esc</kbd>
        </label>
        <div class="search-status" data-search-status>
          Mulai mengetik untuk mencari.
        </div>
        <div class="search-results" data-search-results></div>
      </section>
    </div>

    <div class="settings-layer" data-settings-layer hidden>
      <div class="search-backdrop" data-settings-close></div>
      <section
        class="settings-dialog"
        role="dialog"
        aria-modal="true"
        aria-labelledby="settings-title"
      >
        <div class="search-dialog__head">
          <div>
            <span class="eyebrow">READING MODE</span>
            <h2 id="settings-title">Preferensi membaca</h2>
          </div>
          <button
            class="icon-btn"
            type="button"
            data-settings-close
            aria-label="Tutup"
          >
            ×
          </button>
        </div>
        <div class="settings-grid">
          <div class="setting-card">
            <span class="setting-label">Tema</span>
            <div class="segmented">
              <button data-theme-choice="light">Terang</button>
              <button data-theme-choice="sepia">Sepia</button>
              <button data-theme-choice="dark">Gelap</button>
            </div>
          </div>
          <div class="setting-card">
            <span class="setting-label">Ukuran teks</span>
            <div class="segmented">
              <button data-font-size="small">A−</button>
              <button data-font-size="medium">A</button>
              <button data-font-size="large">A+</button>
            </div>
          </div>
          <div class="setting-card setting-card--wide">
            <span class="setting-label">Lebar bacaan</span>
            <div class="segmented">
              <button data-reading-width="narrow">Sempit</button>
              <button data-reading-width="medium">Standar</button>
              <button data-reading-width="wide">Lebar</button>
            </div>
          </div>
        </div>
        <p class="settings-note">
          Preferensi disimpan di perangkat ini. Pintasan:
          <kbd>⌘K</kbd>
          pencarian,
          <kbd>⌘,</kbd>
          preferensi,
          <kbd>Esc</kbd>
          tutup.
        </p>
      </section>
    </div>

    <footer class="site-footer page--wide">
      <p>© 2026 Mob Elazcona</p>
      <p class="site-footer__credit">
        Made with Claude Code inside Termux.
      </p>
    </footer>

    <script>
      window.CW6_SEARCH_URL = "{{ '/search.json' | url }}";
    </script>
    <script src="{{ '/assets/js/nav.js' | url }}"></script>
  </body>
</html>
