---
layout: layouts/base.njk
permalink: /catatan/index.html
title: Indeks Catatan
description: Daftar paragraf Psychological Types yang sudah dianotasi.
---
<section class="page page--wide annotations-page">
  <header class="index-header">
    <div>
      <span class="eyebrow">ANNOTATION INDEX</span>
      <h1>Daftar catatan.</h1>
      <p>
        Paragraf-paragraf yang sudah punya catatan, dikelompokkan per bab. Klik salah satu untuk membuka halaman paragrafnya — catatannya tampil di sana.
      </p>
    </div>
  </header>

  <div class="index-tools">
    <span data-annotation-count>{{ stats.totalAnnotated }} hasil</span>
    <label>
      <span>Filter</span>
      <input
        data-annotation-filter
        type="search"
        placeholder="Cari bab atau nomor paragraf…"
      />
    </label>
  </div>

  {% if stats.totalAnnotated == 0 %}
    <p class="empty-state">Belum ada catatan yang ditulis.</p>
  {% endif %}

  <div data-annotation-list>
    {% for group in annotatedIndex %}
      <section class="note-group" data-annotation-group>
        <header class="note-group__head">
          <a href="{{ ('/' + group.chapterId + '/') | url }}">{{ group.shortLabel }} · {{ group.chapterTitle }}</a>
          <span class="note-group__count">{{ group.count }} §</span>
        </header>
        <div class="note-group__rows">
          {% for entry in group.entries %}
            <a
              class="note-row"
              data-annotation-entry
              href="{{ ('/' + group.chapterId + '/' + entry.slug + '/') | url }}"
              data-search-text="{{ group.chapterTitle }} §{{ entry.num }} {{ entry.excerpt }}"
            >
              <span class="note-row__num">§{{ entry.num }}</span>
              <span class="note-row__text">{{ entry.excerpt }}</span>
            </a>
          {% endfor %}
        </div>
      </section>
    {% endfor %}
  </div>
  <p class="empty-state empty-state--hidden" data-annotation-empty>
    Tak ada paragraf yang cocok.
  </p>
</section>
