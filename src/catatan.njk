---
layout: layouts/base.njk
permalink: /catatan/index.html
title: Indeks Catatan
description: Semua paragraf Psychological Types yang sudah dianotasi.
---
<section class="page page--wide annotations-page">
  <header class="index-header">
    <div>
      <span class="eyebrow">ANNOTATION INDEX</span>
      <h1>Semua catatan.</h1>
    </div>
  </header>

  <div class="index-tools">
    <span data-annotation-count>{{ annotatedIndex.length }} hasil</span>
    <label>
      <span>Filter</span>
      <input
        data-annotation-filter
        type="search"
        placeholder="Cari isi catatan…"
      />
    </label>
  </div>

  {% if annotatedIndex.length == 0 %}
    <p class="empty-state">Belum ada catatan yang ditulis.</p>
  {% endif %}

  <div data-annotation-list>
    {% for entry in annotatedIndex %}
      <article
        id="{{ entry.slug }}"
        class="annot-entry"
        data-annotation-entry
        data-search-text="{{ entry.chapterTitle }} {{ entry.num }} {{ entry.annotationHtml | excerpt(600) }}"
      >
        <div class="annot-entry__rail">
          <span>§{{ entry.num }}</span>
          <i></i>
        </div>
        <div class="annot-entry__body">
          <a class="annot-entry__chapter" href="{{ ('/' + entry.chapterId + '/' + entry.slug + '/') | url }}">{{ entry.shortLabel }} · {{ entry.chapterTitle }}</a>
          <p class="annot-entry__source">
            {{ entry.paragraphHtml | excerpt(240) }}
          </p>
          <div class="annotation annotation--index">
            {{ entry.annotationHtml | safe }}
          </div>
        </div>
      </article>
    {% endfor %}
  </div>
  <p class="empty-state empty-state--hidden" data-annotation-empty>
    Tak ada catatan yang cocok.
  </p>
</section>
