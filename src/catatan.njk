---
layout: layouts/base.njk
permalink: /catatan/index.html
title: Indeks Anotasi
description: Semua paragraf Psychological Types yang sudah dianotasi, diurutkan sesuai kemunculannya di buku.
---
<div class="page page--wide">
  <header class="chapter-header">
    <p class="chapter-header__symbol">Catatan pembaca</p>
    <h1>Indeks Catatan</h1>
    <div class="chapter-header__meta">
      <span>{{ annotatedIndex.length }} paragraf dianotasi.</span>
      <span>·</span>
    </div>
  </header>

  {% if annotatedIndex.length == 0 %}
    <div class="empty-state empty-state--inline">
      Belum ada catatan yang ditulis.
    </div>
  {% endif %}

  {% if annotatedIndex.length > 0 %}
    <div class="annot-toolbar">
      <div class="annot-search">
        <span class="annot-search__icon">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="8" />
            <line x1="21" y1="21" x2="16.65" y2="16.65" />
          </svg>
        </span>
        <input
          id="annot-filter"
          type="search"
          placeholder="Cari anotasi — paragraf, bab, atau isi anotasi…"
          aria-label="Cari anotasi"
          data-annot-filter
        />
      </div>
    </div>

    <p class="annot-count" data-annot-count>Menampilkan {{ annotatedIndex.length }} dari {{ annotatedIndex.length }} catatan.</p>

    <ul class="annot-list">
      {% for entry in annotatedIndex %}
        <li
          id="{{ entry.slug }}"
          class="annot-entry"
          data-search="{{ entry.num }} {{ entry.chapterTitle }} {{ entry.slug }} {{ entry.annotationHtml | excerpt(500) }}"
        >
          <p class="annot-entry__meta">
            <a
              href="{{ ('/' + entry.chapterId + '/' + entry.slug + '/') | url }}"
            >
              {% if entry.symbol %}
                <span class="annot-entry__symbol">{{ entry.symbol }}.</span>
              {% endif %}
              §
              {{ entry.num }}
              <span class="annot-entry__chapter">— {{ entry.chapterTitle }}</span>
            </a>
          </p>
          <p class="annot-entry__source">
            {{ entry.paragraphHtml | excerpt(200) }}
          </p>
          <div class="annotation">{{ entry.annotationHtml | safe }}</div>
        </li>
      {% endfor %}
    </ul>
  {% endif %}
</div>
